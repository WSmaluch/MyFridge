@page "/shopping"
@inject KitchenApplicationService Kitchen
<PageTitle>Zakupy — Moja Kuchnia</PageTitle>
<div class="page-title"><div><p class="eyebrow">LISTA</p><h1>Zakupy</h1></div><button class="round-action" @onclick="()=>adding=!adding" aria-label="Dodaj produkt">＋</button></div>@if(adding){<div class="form-card compact"><label>Produkt<InputText @bind-Value="newItem.ProductName" /></label><div class="form-pair"><label>Ilość<InputNumber @bind-Value="newItem.Quantity" /></label><label>Jednostka<select @bind="newItem.Unit"><option>szt.</option><option>g</option><option>ml</option></select></label></div><button class="button" @onclick="Add">Dodaj do listy</button></div>}@if(!items.Any()){<div class="empty big">🎉<strong>Lista zakupów jest pusta</strong></div>}else{<div class="shopping-list">@foreach(var item in items){<div class="shopping-item"><input type="checkbox" @bind="item.Checked" @bind:after="()=>Save(item)" aria-label="Oznacz @item.ProductName jako kupione"/><span><strong>@item.ProductName</strong><small>@item.Reason</small></span><b>@item.Quantity @item.Unit</b><button class="text-button" @onclick="()=>Delete(item)">Usuń</button></div>}</div>}
@code{private IReadOnlyList<ShoppingItem>items=[];private ShoppingItem newItem=new(){Unit="szt."};private bool adding;protected override async Task OnInitializedAsync()=>items=await Kitchen.GetShoppingAsync();private async Task Save(ShoppingItem item)=>await Kitchen.SaveShoppingAsync(item);private async Task Add(){if(string.IsNullOrWhiteSpace(newItem.ProductName))return;await Kitchen.AddShoppingAsync(newItem);items=await Kitchen.GetShoppingAsync();newItem=new(){Unit="szt."};adding=false;}private async Task Delete(ShoppingItem item){await Kitchen.DeleteShoppingAsync(item.ShoppingItemId);items=await Kitchen.GetShoppingAsync();}}
