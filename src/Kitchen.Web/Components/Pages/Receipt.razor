@page "/receipt"
@inject IGeminiService Gemini
@inject KitchenApplicationService Kitchen
@inject NavigationManager Nav
<PageTitle>Skanuj paragon — Moja Kuchnia</PageTitle>
<div class="back"><a href="">← Start</a></div><div class="page-title"><div><p class="eyebrow">NOWE ZAKUPY</p><h1>@(result is null ? "Dodaj paragon" : $"Znaleźliśmy {result.Items.Count(x=>x.IncludeInInventory)} produktów")</h1></div></div>
@if(result is null){<div class="receipt-drop"><span>🧾</span><h2>Zrób zdjęcie paragonu</h2><p>Możesz wybrać jedno lub kilka zdjęć. Obsługujemy JPEG, PNG i WEBP.</p><InputFile OnChange="FilesChanged" multiple accept="image/jpeg,image/png,image/webp" /><small>Maks. 10 MB na zdjęcie. Zdjęcie nie jest zapisywane po analizie.</small></div>@if(!string.IsNullOrEmpty(error)){<div class="notice error">@error</div>}@if(analyzing){<div class="analyzing"><span>✦</span><h2>Analizuję paragon…</h2><p>Odczytuję produkty · Porządkuję nazwy · Przygotowuję podsumowanie</p></div>}}
else{<div class="receipt-meta"><span>@result.Store</span><span>@result.PurchaseDate</span><span>@result.Total @result.Currency</span></div><p class="hint">Sprawdź pozycje przed zapisaniem. Produkty z niską pewnością są oznaczone.</p><div class="receipt-items">@foreach(var item in result.Items){<div class="receipt-item @(item.Confidence<.8m?"uncertain":"")"><InputCheckbox @bind-Value="item.IncludeInInventory"/><div class="receipt-fields"><InputText @bind-Value="item.DisplayName"/><div><InputNumber @bind-Value="item.Quantity"/><select @bind="item.Unit"><option>g</option><option>kg</option><option>ml</option><option>l</option><option>szt.</option></select></div><div><select @bind="item.Category"><option>Nabiał</option><option>Mięso</option><option>Warzywa</option><option>Makaron i ryż</option><option>Przyprawy</option><option>Chemia</option><option>Inne spożywcze</option></select><select @bind="item.Location">@foreach(var loc in Enum.GetValues<FoodLocation>()){<option value="@loc">@PolishText.Location(loc)</option>}</select></div>@if(item.Confidence<.8m){<small>⚠ Sprawdź: pewność AI @item.Confidence.ToString("P0")</small>}</div></div>}</div><button class="button wide" @onclick="Confirm" disabled="@saving">@(saving?"Dodaję…":$"Dodaj {result.Items.Count(x=>x.IncludeInInventory)} produktów")</button>}
@code {private List<UploadedImage> images=[];private ReceiptParseResult?result;private bool analyzing,saving;private string?error;private string receiptId=Guid.NewGuid().ToString("N");
private async Task FilesChanged(InputFileChangeEventArgs e){try{error=null;images=[];foreach(var file in e.GetMultipleFiles(5)){if(file.Size>10*1024*1024)throw new InvalidOperationException("Zdjęcie jest większe niż 10 MB.");if(file.ContentType is not ("image/jpeg" or "image/png" or "image/webp"))throw new InvalidOperationException("Wybierz JPEG, PNG lub WEBP.");using var stream=file.OpenReadStream(10*1024*1024);using var ms=new MemoryStream();await stream.CopyToAsync(ms);images.Add(new UploadedImage(ms.ToArray(),file.ContentType,file.Name));}analyzing=true;result=await Gemini.ParseReceiptAsync(images);}catch(Exception ex){error=ex.Message;}finally{analyzing=false;images=[];}}
private async Task Confirm(){if(result is null)return;try{saving=true;var receipt=new Kitchen.Core.Receipt{ReceiptId=receiptId,Store=result.Store,PurchaseDate=result.PurchaseDate,Total=result.Total,Currency=result.Currency,Status="Preview"};await Kitchen.ConfirmReceiptAsync(receipt,result.Items);Nav.NavigateTo("products");}catch(Exception){error="Nie udało się zapisać produktów. Spróbuj ponownie.";}finally{saving=false;}}}
