@page "/recipes/{Id}"
@inject KitchenApplicationService Kitchen
@inject IUnitConversionService Units
@inject NavigationManager Nav
<PageTitle>Przepis — Moja Kuchnia</PageTitle>
@if(recipe is null||availability is null){<p>Ładuję przepis…</p>}else{<div class="back"><a href="recipes">← Przepisy</a></div><section class="recipe-detail"><span class="recipe-art large">🍳</span><div><span class="pill">@recipe.TimeMinutes min</span><h1>@recipe.Name</h1><p>@recipe.Description</p><small>@recipe.Servings porcje · @recipe.Ingredients.Count składników</small></div></section><section class="section-head"><h2>Składniki</h2><span>@availability.AvailableCount/@availability.RequiredCount masz w domu</span></section><div class="ingredients">@foreach(var line in availability.Ingredients){<div class="@(line.Available?"has":"missing")"><b>@(line.Available?"✓":"×")</b><span>@line.Ingredient.Quantity @line.Ingredient.Unit @line.Ingredient.Name</span><small>@line.Reason</small></div>}</div>@if(!availability.CanCook){<button class="secondary-button" @onclick="AddMissing">Dodaj brakujące do zakupów</button>}<section class="steps"><h2>Przygotowanie</h2>@foreach(var step in recipe.Steps.Select((x,i)=>(x,i))){<div><b>@(step.i+1)</b><p>@step.x</p></div>}</section><div class="cookbar">@if(!cooking){<button class="button" @onclick="()=>cooking=true">Zaczynam gotować</button>}else{<p>Smacznego! Odejmę składniki dopiero po potwierdzeniu.</p><button class="button" @onclick="Cook" disabled="@saving">@(saving?"Zapisuję…":"Ugotowane ✓")</button>}</div>@if(!string.IsNullOrWhiteSpace(message)){<div class="notice">@message</div>}}
@code{[Parameter]public string Id{get;set;}=string.Empty;private Recipe? recipe;private RecipeAvailability? availability;private bool cooking,saving;private string?message;protected override async Task OnParametersSetAsync(){recipe=await Kitchen.GetRecipeAsync(Id);if(recipe is not null)availability=await Kitchen.CheckAvailabilityAsync(recipe);}private async Task AddMissing(){if(recipe is null)return;await Kitchen.AddMissingToShoppingAsync(recipe);message="Brakujące składniki dodane do zakupów.";}private async Task Cook(){try{saving=true;await Kitchen.CookRecipeAsync(Id);Nav.NavigateTo("history");}catch(InvalidOperationException ex){message=ex.Message;}finally{saving=false;}}}
