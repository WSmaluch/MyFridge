@page "/products"
@inject KitchenApplicationService Kitchen
@inject IUnitConversionService Units
<PageTitle>Produkty — Moja Kuchnia</PageTitle>
<div class="page-title"><div><p class="eyebrow">ZAPASY</p><h1>Moja kuchnia</h1></div><a href="products/new" class="round-action" aria-label="Dodaj produkt">＋</a></div><input class="search" @bind="search" @bind:event="oninput" placeholder="Szukaj w produktach" aria-label="Szukaj produktów" />
<div class="chips"><button class="@(location is null ? "selected" : "")" @onclick="() => location = null">Wszystko</button>@foreach (var loc in Enum.GetValues<FoodLocation>().Take(3)) { <button class="@(location == loc ? "selected" : "")" @onclick="() => location = loc">@PolishText.Location(loc)</button> }</div>
@if (loading) { <div class="skeleton row-skeleton"></div> } else if (!Filtered.Any()) { <div class="empty big">🥕<strong>Jeszcze nic tu nie ma</strong><span>Zeskanuj pierwszy paragon, a produkty pojawią się tutaj automatycznie.</span><a class="button" href="receipt">Zeskanuj paragon</a></div> } else { @foreach (var group in Filtered.GroupBy(x => x.Location)) { <section class="inventory-group"><h2>@PolishText.Location(group.Key)</h2><div class="inventory-grid">@foreach(var item in group) { <a class="product-card" href="@($"products/{item.ProductId}")"><span class="food-icon">@Icon(item.Category)</span><span><strong>@item.Name</strong><small>@Units.Format(item.Quantity,item.Unit)</small>@if (item.LowStockThreshold is not null && item.Quantity <= item.LowStockThreshold) { <i>Niski stan</i> }</span><b>›</b></a> }</div></section> } }
@code { private bool loading=true; private IReadOnlyList<Product> items=[]; private string search=""; private FoodLocation? location; private IEnumerable<Product> Filtered => items.Where(x => (location is null || x.Location==location) && (string.IsNullOrWhiteSpace(search)||x.Name.Contains(search,StringComparison.CurrentCultureIgnoreCase))); protected override async Task OnInitializedAsync(){items=await Kitchen.GetProductsAsync();loading=false;} private static string Icon(string x)=>x switch{"Nabiał"=>"🥛","Mięso"=>"🍗","Warzywa"=>"🥕","Makaron i ryż"=>"🍝",_=>"🍽"}; }
