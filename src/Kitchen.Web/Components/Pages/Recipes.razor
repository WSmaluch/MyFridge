@page "/recipes"
@inject KitchenApplicationService Kitchen
@inject IGeminiService Gemini
@inject NavigationManager Nav
<PageTitle>Przepisy — Moja Kuchnia</PageTitle>
<div class="page-title"><div><p class="eyebrow">INSPIRACJE</p><h1>Co dziś gotujemy?</h1></div></div>
<div class="form-card compact"><div class="form-pair"><label>Osoby<InputNumber @bind-Value="request.Servings" /></label><label>Maks. czas<select @bind="request.MaxTimeMinutes"><option value="">Dowolny</option><option value="20">20 min</option><option value="30">30 min</option><option value="45">45 min</option></select></label></div><label>Na co masz ochotę?<InputText @bind-Value="request.Craving" placeholder="np. coś z kurczakiem" /></label><button class="button" @onclick="Generate" disabled="@generating">@(generating ? "Tworzę propozycje…" : "✨ Podpowiedz przepisy")</button></div>
@if (!string.IsNullOrEmpty(error)) { <div class="notice error">@error</div> } @if(generating){<div class="skeleton row-skeleton"></div>} else if (!recipes.Any()) { <div class="empty big">🍳<strong>Najpierw dodaj kilka produktów</strong><span>A podpowiem Ci, co możesz ugotować.</span></div> } else { <div class="recipe-cards">@foreach(var recipe in recipes){<a class="recipe-card" href="@($"recipes/{recipe.RecipeId}")"><span class="recipe-art">🍳</span><span class="pill">@recipe.TimeMinutes min</span><h2>@recipe.Name</h2><p>@recipe.Description</p><small>@recipe.Servings porcje · @recipe.Ingredients.Count składników</small></a>}</div> }
@code {private IReadOnlyList<Recipe> recipes=[];private RecipeGenerationRequest request=new();private bool generating;private string? error;protected override async Task OnInitializedAsync()=>recipes=await Kitchen.GetRecipesAsync();private async Task Generate(){try{generating=true;error=null;var output=await Gemini.GenerateRecipesAsync(await Kitchen.GetProductsAsync(),request);foreach(var recipe in output.Recipes){recipe.Source="Gemini";await Kitchen.SaveRecipeAsync(recipe);}recipes=await Kitchen.GetRecipesAsync();}catch(Exception){error="Nie udało się przygotować przepisów. Spróbuj ponownie.";}finally{generating=false;}}}
