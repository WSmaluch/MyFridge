@page "/history"
@inject KitchenApplicationService Kitchen
@inject IUnitConversionService Units
<PageTitle>Historia — Moja Kuchnia</PageTitle><div class="page-title"><div><p class="eyebrow">OŚ CZASU</p><h1>Historia</h1></div></div><div class="chips"><button class="selected">Wszystko</button><button>Zakupy</button><button>Gotowanie</button><button>Korekty</button></div>@if(events is null){<div class="skeleton row-skeleton"></div>}else{<div class="timeline">@foreach(var group in events.GroupBy(x=>x.Timestamp.Date==DateTimeOffset.UtcNow.Date?"Dzisiaj":x.Timestamp.ToLocalTime().ToString("dd.MM.yyyy"))){<h2>@group.Key</h2>@foreach(var e in group){<div class="history-event"><span class="event-symbol @(e.DeltaQuantity>=0?"plus":"minus")">@(e.DeltaQuantity>=0?"+":"−")</span><span><strong>@e.ProductName</strong><small>@e.Type switch { HistoryType.Purchase => "Zakupy", HistoryType.Recipe => "Przepis", HistoryType.Waste => "Wyrzucone", _ => "Ręczna korekta" } · @e.Description</small></span><b>@(e.DeltaQuantity>=0?"+":"")@Units.Format(e.DeltaQuantity,e.Unit)</b></div>}}</div>}
@code{private IReadOnlyList<HistoryEvent>?events;protected override async Task OnInitializedAsync()=>events=await Kitchen.GetHistoryAsync();}
