@page "/products/{Id}"
@page "/products/new"
@inject KitchenApplicationService Kitchen
@inject NavigationManager Nav
<PageTitle>Produkt — Moja Kuchnia</PageTitle>
@if (product is null) { <p>Ładuję produkt…</p> } else { <div class="back"><a href="products">← Produkty</a></div><h1>@(Id is null ? "Nowy produkt" : product.Name)</h1><EditForm Model="product" OnValidSubmit="Save"><DataAnnotationsValidator /><div class="form-card"><label>Nazwa<InputText @bind-Value="product.Name" /></label><div class="form-pair"><label>Ilość<InputNumber @bind-Value="product.Quantity" /></label><label>Jednostka<select @bind="product.Unit"><option>g</option><option>kg</option><option>ml</option><option>l</option><option>szt.</option></select></label></div><label>Kategoria<InputText @bind-Value="product.Category" /></label><label>Miejsce<select @bind="product.Location">@foreach(var loc in Enum.GetValues<FoodLocation>()){<option value="@loc">@PolishText.Location(loc)</option>}</select></label><label class="switch"><InputCheckbox @bind-Value="product.AlwaysAvailable" /> Zawsze dostępne (np. sól)</label><label>Próg niskiego stanu<InputNumber @bind-Value="product.LowStockThreshold" /></label><label>Notatka<InputTextArea @bind-Value="product.Notes" /></label></div><div class="actions"><button class="button" disabled="@saving">@(saving ? "Zapisuję…" : "Zapisz zmiany")</button>@if(Id is not null){<button type="button" class="ghost danger" @onclick="Empty">Skończyło się</button>}</div></EditForm> }
@code { [Parameter] public string? Id {get;set;} private Product? product; private bool saving; protected override async Task OnParametersSetAsync(){product=Id is null?new Product{Location=FoodLocation.Szafka}:await Kitchen.GetProductAsync(Id);} private async Task Save(){if(product is null)return;saving=true;await Kitchen.SaveProductAsync(product);Nav.NavigateTo("products");} private async Task Empty(){if(product is null)return;await Kitchen.AdjustQuantityAsync(product.ProductId,-product.Quantity,HistoryType.Waste,"Produkt się skończył");Nav.NavigateTo("products");} }
