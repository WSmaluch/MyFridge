@inherits LayoutComponentBase
@inject IJSRuntime JS

<div class="app-shell">
    <header class="app-header"><a href="" class="brand" aria-label="Moja Kuchnia — start"><span>✦</span> Moja Kuchnia</a><button type="button" class="icon-button" aria-label="Przełącz motyw" title="Przełącz motyw" @onclick="ToggleThemeAsync">☼</button></header>
    <main class="content">@Body</main>
    <nav class="bottom-nav" aria-label="Główna nawigacja">
        <NavLink href="" Match="NavLinkMatch.All"><span>⌂</span>Start</NavLink>
        <NavLink href="products"><span>🥕</span>Produkty</NavLink>
        <NavLink href="recipes"><span>🍳</span>Przepisy</NavLink>
        <NavLink href="shopping"><span>🛒</span>Zakupy</NavLink>
        <NavLink href="more"><span>☼</span>Więcej</NavLink>
    </nav>
</div>

@code {
    private async Task ToggleThemeAsync() => await JS.InvokeVoidAsync("kitchenTheme.toggle");
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
